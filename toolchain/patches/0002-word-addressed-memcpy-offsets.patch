+/// Byte offset to address offset (word-addressed targets).
+static int64_t memAddrOffset(SelectionDAG &DAG, uint64_t ByteOff) {
+  if (DAG.getTarget().getTargetTriple().getArch() == Triple::teak)
+    return ByteOff >> 1;
+  return ByteOff;
+}
