diff --git a/llvm/lib/Analysis/ConstantFolding.cpp b/llvm/lib/Analysis/ConstantFolding.cpp
index 280a13ff115..22078998ec4 100644
--- a/llvm/lib/Analysis/ConstantFolding.cpp
+++ b/llvm/lib/Analysis/ConstantFolding.cpp
@@ -910,6 +910,9 @@ Constant *SymbolicallyEvaluateGEP(const GEPOperator *GEP,
   auto *PTy = cast<PointerType>(Ptr->getType());
   if ((Ptr->isNullValue() || BasePtr != 0) &&
       !DL.isNonIntegralPointerType(PTy)) {
+    // Word-addressed target: offsets are bytes, pointers words.
+    if (DL.getTypeAllocSize(Type::getInt8Ty(Ptr->getContext())) == 2)
+      Offset = Offset.ashr(1);
     Constant *C = ConstantInt::get(Ptr->getContext(), Offset + BasePtr);
     return ConstantExpr::getIntToPtr(C, ResTy);
   }
diff --git a/llvm/lib/Analysis/ScalarEvolutionExpander.cpp b/llvm/lib/Analysis/ScalarEvolutionExpander.cpp
index dc5d02aa3a3..f07e1efaa7d 100644
--- a/llvm/lib/Analysis/ScalarEvolutionExpander.cpp
+++ b/llvm/lib/Analysis/ScalarEvolutionExpander.cpp
@@ -472,14 +472,15 @@ Value *SCEVExpander::expandAddToGEP(const SCEV *const *op_begin,
       if (const SCEVConstant *C = dyn_cast<SCEVConstant>(Ops[0]))
         if (SE.getTypeSizeInBits(C->getType()) <= 64) {
           const StructLayout &SL = *DL.getStructLayout(STy);
-          uint64_t FullOffset = C->getValue()->getZExtValue();
+          // SCEV offsets are words here; StructLayout wants bytes.
+          uint64_t FullOffset = C->getValue()->getZExtValue() * 2;
           if (FullOffset < SL.getSizeInBytes()) {
             unsigned ElIdx = SL.getElementContainingOffset(FullOffset);
             GepIndices.push_back(
                 ConstantInt::get(Type::getInt32Ty(Ty->getContext()), ElIdx));
             ElTy = STy->getTypeAtIndex(ElIdx);
             Ops[0] =
-                SE.getConstant(Ty, FullOffset - SL.getElementOffset(ElIdx));
+                SE.getConstant(Ty, (FullOffset - SL.getElementOffset(ElIdx)) / 2);
             AnyNonZeroIndices = true;
             FoundFieldNo = true;
           }
